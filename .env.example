# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here
BOT_USERNAME=ieltssat_dailybot

# Administrator Telegram IDs (comma-separated integers)
ADMIN_IDS=12345678,87654321

# Channel for daily posts
CHANNEL_ID=@ieltssat_daily
CHANNEL_URL=https://t.me/ieltssat_daily
# Students must join the channel to use the bot and the Mini App. Set 0 to turn it off.
REQUIRE_SUBSCRIPTION=1

# Public Mini App URL
WEBAPP_URL=https://sat-master-bot.onrender.com/webapp
PORT=8080
TIMEZONE=Asia/Tashkent

# Postgres connection string. Without it, progress is lost on every Render deploy.
DATABASE_URL=

# AI Writing (Gemini Developer API)
GEMINI_API_KEY=
AI_DAILY_LIMIT=3

# Optional
DESMOS_API_KEY=
SENTRY_DSN=
