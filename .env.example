# Telegram Bot Token (from @BotFather)
BOT_TOKEN=your_telegram_bot_token_here

# Administrator Telegram IDs (comma-separated integers)
ADMIN_IDS=12345678,87654321

# WebApp public URL (Render.com or Cloudflare tunnel)
WEBAPP_URL=http://127.0.0.1:8080/webapp

# Port for local web server
PORT=8080

# Academy & Brand Settings
CENTER_NAME="MARSTIF ACADEMY"
MENTOR_NAME="Marifat Jamal"

# Optional Cloud Backup Channel (e.g. @your_backup_channel)
# Leave empty if automatic cloud channel backup is not required
BACKUP_CHANNEL=

# Optional MongoDB Atlas URI
# Leave empty to use resilient atomic local storage (users_db.json)
MONGO_URI=
